# ContentFactory — copy to `.env` and fill in. Loaded by shared/config.py.
# Only stage 1 needs a paid API key; stages 2-5 run entirely on local models.

# ── LLM (stage 1: story / script / scene prompts) ─────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Google Drive: the system of record ───────────────────────────────────────
# Authorize ONCE with `python scripts/drive_auth.py`, then copy credentials.json
# + token.json to every machine. Workers only ever refresh — never a browser prompt.
DRIVE_PARENT_FOLDER_ID=your_drive_folder_id
DRIVE_CLIENT_SECRETS=/abs/path/to/credentials.json
DRIVE_TOKEN_PATH=/abs/path/to/token.json
DRIVE_DB=1                      # 1 = manifest lives in Drive (multi-machine). 0 = local only.
# DRIVE_SA_KEY_PATH=./drive_sa_key.json   # optional service-account fallback

# ── Narration engine (stage 2) ───────────────────────────────────────────────
NARRATION_ENGINE=fish           # fish (local GPU, default) | elevenlabs
# ELEVENLABS_API_KEY=sk_...     # only if NARRATION_ENGINE=elevenlabs

# ── Music + mix (stages 4 & 5) ───────────────────────────────────────────────
BGM_TWO_PASS=1                  # 1 = two-pass techC brief; 0 = single pass (REQUIRED on 24 GB)
BGM_LOUDNESS_RATIO=0.42         # BGM level as a fraction of the narration's measured LUFS
# ACE_REPO_DIR=/abs/path/to/ACE-Step-1.5          # provisioned out-of-band
# ACE_CHECKPOINTS=/abs/path/to/ace-checkpoints

# ── Performance toggles (measured — see docs/PERFORMANCE.md) ─────────────────
FISH_COMPILE=1                  # ~2.1x faster Fish TTS; amortizes over a batch
FLUX_COMPILE=1                  # ~18% faster FLUX
FLUX_COMPILE_MODE=default       # never "reduce-overhead" on 24 GB (CUDA graphs OOM)
# LLM_PROMPT_CACHE=0            # measured no-op — providers auto-cache anyway

# ── Paths ────────────────────────────────────────────────────────────────────
HF_HOME=./models/hf_cache       # repo-local weight cache shared by setup + runtime
DB_PATH=manifest.sqlite         # local SQLite working copy
OUTPUT_DIR=./output             # scratch dir for in-flight artifacts

# ── Review + publishing layer (optional — see docs/PUBLISHING.md) ────────────
# SHEET_ID=...                  # review-queue Google Sheet (created by scripts/seed_sheet.py)
# REVIEW_USERS=alice:pw1,bob:pw2
# UPLOAD_INTERVAL_HOURS=4
# IG_USERNAME=
# IG_PASSWORD=
# YT_TOKEN_PATH=/abs/path/to/yt_token.json
