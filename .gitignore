outputs/
work_*/
examples/
Notebooks/
sample_results/
*.mp3
*.wav
*.mp4
*.png
*.jpg
*.jpeg
*.ass

# ── ...except the committed README media (compressed previews) ────────────────
!docs/media/**/*.mp4
!docs/media/**/*.jpg
!docs/media/**/*.png
!docs/media/*.gif

# ── Benchmark run artifacts (the harness + findings ARE committed) ────────────
bench/*.log
bench/*.jsonl
bench/out_*/
bench/*.sqlite
bench/bench_folder_id.txt

